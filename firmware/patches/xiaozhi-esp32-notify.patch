+            }
+            frame_count = data[1] & 0x3f;
+            break;
+    }
+
+    const int packet_duration_us = frame_duration_us * frame_count;
+    if (frame_count == 0 || packet_duration_us > 120000 || packet_duration_us % 1000 != 0) {
+        return -1;
+    }
+    return packet_duration_us / 1000;
