+void Application::RequestUserExit() {
+    // StackChan (v1.9.10): 用户主动退出连续对话（语音"退下"/MCP 工具）。
+    // 先置位退出标记，再关闭音频通道；通道关闭回调看到标记后保持 idle。
+    ESP_LOGI(TAG, "User exit requested (voice/screen), closing audio channel");
+    // StackChan (v1.9.12): 用户意图优先——若有待插播，放弃"播完恢复监听"
+    broadcast_text_.clear();
+    broadcast_resume_after_ = false;
+    user_exit_requested_ = true;
+    Schedule([this]() {
+        if (protocol_ && protocol_->IsAudioChannelOpened()) {
+            protocol_->CloseAudioChannel();
+        } else {
+            // 通道未开时也要回到 idle，保持状态一致
+            SetDeviceState(kDeviceStateIdle);
+        }
+    });
+}
+
+bool Application::RequestBroadcastPlayback(const std::string& text) {
+    // StackChan (v1.9.12): 播报插播。
+    // 空闲 → 直接交给播放器（TTS 任务队列），返回 true；
+    // 监听中 → 记下文本、退会话，通道关闭回调里再播，
+    //          播完由 PLAYBACK_DRAINED 分支恢复连续对话（仅自动连聊模式）；
+    // 其他状态（说话中/连接中/激活中/播报中）→ 返回 false，调用方下一轮再试。
+    if (text.empty() || !broadcast_player_) {
+        return false;
+    }
+    auto state = GetDeviceState();
+    if (state == kDeviceStateIdle) {
+        ESP_LOGI(TAG, "Broadcast requested while idle, playing now");
+        broadcast_player_(text);
+        return true;
+    }
+    if (state != kDeviceStateListening) {
+        ESP_LOGI(TAG, "Broadcast requested while %s, will retry later",
+                 state_machine_.GetStateName(state));
+        return false;
+    }
+    ESP_LOGI(TAG, "Broadcast requested while listening, exiting session to play");
+    broadcast_text_ = text;
+    broadcast_resume_after_ = (listening_mode_ != kListeningModeManualStop);
+    user_exit_requested_ = true;  // 阻止通道关闭回调里的自动重开
+    Schedule([this]() {
+        if (protocol_ && protocol_->IsAudioChannelOpened()) {
+            protocol_->CloseAudioChannel();
+        } else {
+            // 通道实际没开（罕见）：直接在主循环里播
+            SetDeviceState(kDeviceStateIdle);
+            std::string t = std::move(broadcast_text_);
+            broadcast_text_.clear();
+            user_exit_requested_ = false;
+            if (!broadcast_player_(t)) {
+                broadcast_resume_after_ = false;
+            }
+        }
+    });
+    return true;
+}
